# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
POSTGRES_USER=clipdub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clipdub
DATABASE_URL=postgresql+psycopg://clipdub:change-me@postgres:5432/clipdub

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Anthropic (highlight detection, translation, caption suggestions) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Storage ---
STORAGE_ROOT=/storage

# --- Whisper / transcription ---
# Use a small model (tiny/base/small) for quick local testing without a GPU;
# use large-v3 for production-quality transcripts on a GPU host.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# --- Dubbing / TTS ---
# One of: piper, xtts (see scripts/tts_fa_poc.py before choosing for Persian)
TTS_ENGINE=piper
PIPER_FA_VOICE_PATH=/models/piper/fa_IR-voice.onnx

# --- API / Dashboard ---
API_BASE_URL=http://api:8000

# --- Cloudflare Tunnel (optional secure remote access to dashboard/API) ---
# Create the tunnel in the Cloudflare Zero Trust dashboard (Networks > Tunnels),
# add Public Hostnames pointing at http://dashboard:8501 and http://api:8000,
# then paste its token here. See docs/cloudflare-tunnel.md.
CLOUDFLARE_TUNNEL_TOKEN=
